# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram user/chat ID (get it from @userinfobot on Telegram)
TELEGRAM_CHAT_ID=your_chat_id_here

# Product Configuration
PRODUCT_URL=https://blinkit.com/prn/x/prid/763266
PRODUCT_ID=763266
PRODUCT_NAME=PlayStation 5 Gaming Console Standard Edition E Chassis (White)

# Comma-separated pincodes to monitor
PINCODES=411040,411045,411060

# Minutes to wait before re-notifying for the same pincode
NOTIFICATION_COOLDOWN_MINUTES=30
